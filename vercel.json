{
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/business", "destination": "/api/og-preview?business=1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/domains.js": {
      "maxDuration": 280
    }
  }
}
